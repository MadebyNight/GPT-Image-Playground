{
  "name": "gpt-image-playground",
  "private": true,
  "version": "0.3.5",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "mock:api": "node scripts/mock-image-api.mjs",
    "build": "tsc -b && vite build",
    "build:gateway": "npm --prefix gateway run build",
    "build:all": "npm run build && npm run build:gateway",
    "deploy:cf": "npm run build && wrangler deploy",
    "preview": "vite preview",
    "test": "vitest run --exclude e2e/**",
    "test:docker-config": "docker compose config --quiet",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:gateway": "npm --prefix gateway test",
    "test:all": "npm run test && npm run test:gateway",
    "test:watch": "vitest --exclude e2e/**"
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.0",
    "fflate": "^0.8.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^6.3.2",
    "vitest": "^4.1.5",
    "wrangler": "^4.88.0"
  }
}
