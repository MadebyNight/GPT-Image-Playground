# Dokploy / Docker Compose environment example.
# Copy these variables to Dokploy's Environment tab, or create a local .env file.

# Compatible mode: the browser keeps using its own API Key, and the server proxy is optional.
DEFAULT_API_URL=https://api.openai.com/v1
API_PROXY_URL=https://api.openai.com/v1
ENABLE_API_PROXY=false
LOCK_API_PROXY=false

# Server-managed mode: set SERVER_API_CONFIG_ENABLED=true to hide and lock the API config.
# A unified Agent needs the active server API mode to be `responses`; keep `responses` in
# SERVER_API_MODE_OPTIONS so the Agent's mandatory Responses path can be available.
# Public deployments should add authentication, VPN, IP allowlist, or gateway rate limits.
SERVER_API_CONFIG_ENABLED=false
SERVER_API_UPSTREAM_URL=https://api.openai.com/v1
SERVER_API_KEY=
SERVER_API_MODEL=gpt-image-2
SERVER_API_MODE=images
SERVER_API_MODEL_OPTIONS=gpt-image-2,gpt-5.5
SERVER_API_MODE_OPTIONS=images,responses
SERVER_API_ALLOW_CUSTOM_MODEL=true
SERVER_API_CODEX_CLI=false
SERVER_API_RESPONSE_FORMAT_B64_JSON=false
SERVER_API_TIMEOUT_SECONDS=600

# Unified Agent Gateway (trusted deployment): enable this only after Responses is usable, then run
# `docker compose up -d --build`. Responses remains the Agent's prerequisite; this switch alone
# cannot enable the Agent. While false, the Gateway stays health-only and Nginx removes /agent-api/.
RESTRICTED_AGENT_ENABLED=false
# Optional: hide Gallery and open the unified Agent workspace by default when the Gateway is enabled.
# This does not change automatic routing or bypass the Responses prerequisite.
# Gateway action chains only serve hard constraints. In a server-managed Responses deployment, the
# reachable Gateway also relays normal Agent Responses through /agent-api/v1/responses/image.
# The relay reuses AGENT_UPSTREAM_BASE_URL, AGENT_API_KEY and AGENT_PLANNER_MODEL below; do not add
# a second Responses upstream or credential variable. Existing /api-proxy remains the fallback for
# ordinary Responses when Gateway is unavailable.
RESTRICTED_AGENT_ONLY=false
AGENT_PUBLIC_ORIGIN=https://image.example.internal
AGENT_SESSION_SECRET=
AGENT_UPSTREAM_BASE_URL=https://api.openai.com/v1
AGENT_API_KEY=
AGENT_PLANNER_MODEL=gpt-5.5
AGENT_IMAGE_MODEL=gpt-image-2

# Non-secret policy limits. The Gateway capability endpoint publishes the effective values.
AGENT_PLAN_TTL_SECONDS=900
AGENT_ASSET_TTL_SECONDS=86400
AGENT_MAX_REFERENCE_IMAGES=16
AGENT_MAX_FILE_BYTES=20971520
AGENT_MAX_UPLOAD_BYTES=134217728
AGENT_MAX_IMAGE_PIXELS=40000000
AGENT_MAX_OUTPUT_IMAGES=4
AGENT_MAX_QUEUE=10
AGENT_MAX_CONCURRENCY=2
AGENT_PLAN_RATE_PER_MINUTE=5
AGENT_EXECUTE_RATE_PER_MINUTE=2
AGENT_IMAGES_RATE_PER_HOUR=20
AGENT_PLANNER_TIMEOUT_MS=60000
AGENT_EXECUTOR_TIMEOUT_MS=180000
# 严格规格规划联网搜索：开启后由 Gateway 通过 Compose 内网调用 open-websearch。
# 搜索结果仅用于规划参考，不会直接抓取任意网页内容。
AGENT_WEB_SEARCH_ENABLED=true
AGENT_WEB_SEARCH_BASE_URL=http://web-search:3210
AGENT_WEB_SEARCH_TIMEOUT_MS=10000
AGENT_WEB_SEARCH_MAX_RESULTS=5
AGENT_WEB_SEARCH_RATE_PER_MINUTE=5
WEB_SEARCH_DEFAULT_ENGINE=duckduckgo
WEB_SEARCH_ALLOWED_ENGINES=duckduckgo,bing,baidu
WEB_SEARCH_USE_PROXY=false
WEB_SEARCH_PROXY_URL=
# Nginx 对 Gateway action 链和受控 Responses relay 的读写超时。
AGENT_REQUEST_TIMEOUT_SECONDS=600
AGENT_LOG_LEVEL=info
