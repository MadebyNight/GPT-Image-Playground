# ---- Build stage ----
FROM --platform=$BUILDPLATFORM node:22-alpine AS build

WORKDIR /app

ENV DEPLOY_TARGET=runtime
ENV VITE_DEFAULT_API_URL=__VITE_DEFAULT_API_URL_PLACEHOLDER__
ENV VITE_API_PROXY_AVAILABLE=__VITE_API_PROXY_AVAILABLE_PLACEHOLDER__
ENV VITE_API_PROXY_LOCKED=__VITE_API_PROXY_LOCKED_PLACEHOLDER__
ENV VITE_DOCKER_DEPLOYMENT=__VITE_DOCKER_DEPLOYMENT_PLACEHOLDER__
ENV VITE_DOCKER_LEGACY_API_URL_USED=__VITE_DOCKER_LEGACY_API_URL_USED_PLACEHOLDER__

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

# ---- Production stage ----
FROM nginx:alpine

ENV HOST=0.0.0.0
ENV PORT=80
ENV DEFAULT_API_URL=
ENV API_PROXY_URL=
ENV ENABLE_API_PROXY=false
ENV LOCK_API_PROXY=false
ENV SERVER_API_CONFIG_ENABLED=false
ENV SERVER_API_UPSTREAM_URL=
ENV SERVER_API_KEY=
ENV SERVER_API_MODEL=gpt-image-2
ENV SERVER_API_MODE=images
ENV SERVER_API_MODEL_OPTIONS=gpt-image-2,gpt-5.5
ENV MODEL_PROTOCOLS=gpt-image-2:images,gpt-5.5:responses
ENV SERVER_API_MODE_OPTIONS=images,responses
ENV SERVER_API_ALLOW_CUSTOM_MODEL=true
ENV SERVER_API_CODEX_CLI=false
ENV SERVER_API_RESPONSE_FORMAT_B64_JSON=false
ENV SERVER_API_TIMEOUT_SECONDS=600
ENV RESTRICTED_AGENT_ENABLED=false
ENV RESTRICTED_AGENT_ONLY=false
ENV AGENT_REQUEST_TIMEOUT_SECONDS=600

COPY --from=build /app/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/templates/default.conf.template
COPY --chmod=755 deploy/migrate-api-env.envsh /docker-entrypoint.d/05-migrate-api-env.envsh
COPY --chmod=755 deploy/inject-api-url.sh /docker-entrypoint.d/40-inject-api-url.sh

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
